# Copy this file to .env and fill in your real secrets.
# Do NOT commit your real .env into version control.

# Mailgun API settings (preferred)
MAILGUN_API_KEY=key-your-mailgun-api-key
MAILGUN_SENDER_DOMAIN=mg.example.com

# Optional SMTP fallback
EMAIL_HOST=smtp.mailgun.org
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Test recipient
EMAIL_TEST_TO=you@example.com

# Django settings helpers
SECRET_KEY=your-secret-key
DEBUG=True

# Public site URL used in email templates
PUBLIC_SITE_URL=https://kisii-university-digital-logbook.onrender.com
